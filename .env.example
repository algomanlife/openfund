# .env.example — copy to .env per app as needed; NEVER commit real secrets.
# Full reference: docs/deployment/ENVIRONMENT.md

# ---- apps/web-react (.env) — all VITE_* values are PUBLIC (bundled into the browser) ----
VITE_BACKEND_URL=http://localhost:8080
VITE_DIRECTUS_URL=http://localhost:8055
# optional: full remote wallet list (cloud.reown.com, free)
VITE_WALLETCONNECT_PROJECT_ID=
# optional: owner-verified https://t.me/<community> or invitation URL; blank = Coming Soon
VITE_TELEGRAM_COMMUNITY_URL=
# optional: DePay checkout widget (needs BOTH; widget stays hidden without an URL)
VITE_DEPAY_WIDGET=
VITE_DEPAY_WIDGET_URL=

# ---- apps/backend (shell env or .env) ----
DATABASE_URL=postgres://openfund_cms:openfund_local_dev@127.0.0.1:5432/openfund_cms
ALLOWED_DOMAINS=localhost:5173,localhost:4173,127.0.0.1:5173,127.0.0.1:4173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
SESSION_TTL_HOURS=168
PORTFOLIO_TZ=UTC
# internal E2E test seam — never enable outside local test runs
SIM_TEST_MODE=

# ---- challenge purchases (apps/backend) ----
# payment destination: UNSET = purchasing disabled (no production activation
# without explicit approval; never hardcode a production address anywhere)
PURCHASE_PAYMENT_RECEIVER=
PURCHASE_PAYMENT_CHAIN=11155111
# optional ERC-20 payment token (unset = native ETH)
PURCHASE_PAYMENT_TOKEN=
PURCHASE_PAYMENT_DECIMALS=18

# ---- Render production (entered in the dashboard, never here) ----
# openfund-cms: ADMIN_EMAIL / ADMIN_PASSWORD / PUBLIC_URL  (sync: false at first apply)
# openfund:     VITE_WALLETCONNECT_PROJECT_ID / CORS_ORIGINS (sync: false)
# openfund:     PURCHASE_PAYMENT_RECEIVER / PURCHASE_PAYMENT_TOKEN (sync: false —
#               purchases stay disabled until an approved address is entered)

# Directus database configuration (Render supplies the same managed Postgres URL):
# DB_CLIENT=pg
# DB_CONNECTION_STRING=postgresql://user:password@database:5432/openfund
# Local compose already provides DB_CLIENT + individual DB_HOST/DB_* values.
