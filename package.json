{
  "name": "openfund",
  "version": "0.1.0",
  "private": true,
  "description": "Openfund monorepo — root orchestration only. Applications install their own dependencies (apps/web-react, apps/backend) with per-app lockfiles; this package adds no runtime dependencies.",
  "scripts": {
    "build:web": "npm --prefix apps/web-react run build",
    "build:web:publish": "npm --prefix apps/web-react run build -- --mode publish",
    "build:backend": "npm --prefix apps/backend run migrate",
    "test:web": "npm --prefix apps/web-react run test:plans && npm --prefix apps/web-react run test:checkout && npm --prefix apps/web-react run test:information && npm --prefix apps/web-react run test:markets && npm --prefix apps/web-react run test:depth && npm --prefix apps/web-react run test:website && npm --prefix apps/web-react run test:typography && npm --prefix apps/web-react run test:whitepaper && npm --prefix apps/web-react run test:terminal && npm --prefix apps/web-react run test:governance && npm --prefix apps/web-react run test:chart && npm --prefix apps/web-react run test:content && npm --prefix apps/web-react run test:content-registry && npm --prefix apps/web-react run check:product-rules",
    "test:backend": "npm --prefix apps/backend run test:all",
    "typecheck": "npm --prefix apps/web-react run typecheck",
    "validate:blueprint": "node infra/render/validate-blueprint.mjs",
    "infra:check": "node scripts/liara/check-infra.mjs",
    "dev:web": "npm --prefix apps/web-react run dev",
    "dev:backend": "npm --prefix apps/backend run dev",
    "test:browser:audit": "node e2e/test-integration-audit.cjs",
    "test:browser:live": "node e2e/test-dual-terminals.js",
    "docs:language": "node scripts/docs/check-language.mjs",
    "docs:links": "node scripts/docs/check-links.mjs",
    "docs:markdown": "markdownlint-cli2",
    "docs:mermaid": "node scripts/docs/check-mermaid.mjs",
    "docs:required": "node scripts/docs/check-required.mjs",
    "legal:licenses": "node scripts/legal/dependency-licenses.mjs --check",
    "deps:check": "node --test scripts/deps/*.test.mjs && node scripts/deps/check-registry.mjs",
    "docs:status": "node --test scripts/docs/test/status.test.mjs && node scripts/docs/status.mjs --check",
    "docs:readme": "node scripts/docs/check-readme.mjs",
    "docs:write": "node scripts/docs/status.mjs && node scripts/docs/check-retired.mjs --write && node scripts/docs/check-readme.mjs --write",
    "docs:impact": "node scripts/docs/check-docs-impact.mjs",
    "docs:retired": "node scripts/docs/check-retired.mjs",
    "docs:fonts": "node scripts/docs/check-fonts.mjs",
    "docs:gates:test": "node --test scripts/docs/test/gates.test.mjs",
    "docs:check": "npm run docs:status && npm run docs:readme && npm run docs:retired && npm run docs:fonts && npm run docs:gates:test && npm run docs:language && npm run docs:links && npm run docs:markdown && npm run docs:mermaid && npm run docs:required && npm run legal:licenses && npm run deps:check",
    "test:charts": "node --test packages/openfund-charts/test/pine.test.mjs packages/openfund-charts/test/indicators.test.mjs",
    "bench:charts": "node --expose-gc packages/openfund-charts/bench/pine-bench.mjs",
    "test:footprint": "node --test packages/openfund-footprint/test/*.test.mjs",
    "test:browser:charts": "node e2e/test-chart-indicators.mjs",
    "test:browser:footprint": "node e2e/test-footprint.cjs",
    "test:browser:unified": "node e2e/test-unified-trading.cjs",
    "test:browser:layout": "node e2e/test-terminal-layout.cjs",
    "test:browser:completion": "node e2e/test-terminal-completion.cjs",
    "test:browser:risk": "node e2e/test-terminal-risk-workspace.cjs",
    "release:build": "node scripts/release/build.mjs",
    "release:local": "node scripts/release/local.mjs",
    "release:version": "node scripts/release/version.mjs",
    "test:release": "node --test scripts/release/test/*.test.mjs",
    "test:browser:release": "node e2e/test-release.cjs",
    "test:browser:payout-operations": "node e2e/test-payout-operations.cjs",
    "test:browser:certificates": "node e2e/test-certificates.cjs",
    "test:browser:chart-protection": "node e2e/test-chart-protection.cjs",
    "test:browser:purchase": "node e2e/test-purchase-flow.cjs",
    "test:browser:depay": "node e2e/test-depay-checkout.cjs",
    "test:browser:challenge": "node e2e/test-challenge-lifecycle.cjs",
    "test:browser:auto-dark": "node e2e/test-auto-dark.cjs",
    "test:browser:routes": "node scripts/release/public-routes.mjs",
    "test:browser:routing": "node e2e/test-clean-routing.cjs",
    "test:browser:polish": "node e2e/test-ui-polish.cjs",
    "test:browser:website": "node e2e/test-website-refresh.cjs",
    "test:browser:wallet-showcase": "node e2e/test-wallet-showcase.cjs",
    "test:browser:heatmap-radar": "node e2e/test-heatmap-radar.cjs",
    "test:browser:heatmap-radar:live": "node e2e/test-heatmap-radar-live.cjs",
    "test:browser:wallet": "node e2e/test-wallet-connect.cjs",
    "test:browser:locale": "node e2e/test-locale-matrix.cjs",
    "test:browser:language-select": "node e2e/test-language-select.cjs",
    "test:browser:responsive": "node e2e/test-responsive-navigation.cjs",
    "test:browser:responsive-matrix": "node e2e/test-responsive-matrix.cjs",
    "test:upstream": "node --test scripts/upstream/test/*.test.mjs && node --test apps/backend/test/market-data-contract.test.mjs",
    "check:upstream": "node scripts/upstream/verify.mjs",
    "check:gains-live": "node scripts/upstream/gains-live-check.mjs",
    "check:gains-account-live": "node scripts/upstream/gains-account-live-check.mjs",
    "update:vendor": "node scripts/upstream/update-vendor.mjs",
    "watch:upstream": "node scripts/upstream/check-releases.mjs",
    "test:browser:security": "node e2e/test-security-browser.cjs",
    "test:browser:perpetual": "node e2e/test-perpetual-readiness.cjs",
    "test:browser:perpetual-simulation": "node e2e/test-perpetual-simulation.cjs",
    "test:browser:journeys": "node e2e/test-journey-acceptance.cjs",
    "test:browser:typography": "node e2e/test-typography.mjs"
  },
  "devDependencies": {
    "axe-core": "4.14.0",
    "js-yaml": "^4.1.0",
    "jsdom": "27.4.0",
    "markdownlint-cli2": "0.24.1",
    "mermaid": "12.3.0",
    "playwright": "^1.65.1"
  },
  "overrides": {
    "markdownlint": {
      "re2js": "2.8.7"
    },
    "micromark-extension-math": {
      "katex": "0.18.11"
    }
  }
}
