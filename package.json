{
  "name": "openfund",
  "version": "0.1.0",
  "private": true,
  "description": "Openfund monorepo \u2014 root orchestration only. Applications install their own dependencies (apps/web-react, apps/backend) with per-app lockfiles; this package adds no runtime dependencies.",
  "scripts": {
    "build:web": "npm --prefix apps/web-react run build",
    "build:web:publish": "npm --prefix apps/web-react run build -- --mode publish",
    "build:backend": "npm --prefix apps/backend run migrate",
    "test:web": "npm --prefix apps/web-react run test:plans && npm --prefix apps/web-react run test:information && npm --prefix apps/web-react run test:markets && npm --prefix apps/web-react run test:depth && npm --prefix apps/web-react run test:website && npm --prefix apps/web-react run test:whitepaper && npm --prefix apps/web-react run test:terminal && npm --prefix apps/web-react run test:governance && npm --prefix apps/web-react run test:chart",
    "test:backend": "npm --prefix apps/backend run test:all",
    "typecheck": "npm --prefix apps/web-react run typecheck",
    "validate:blueprint": "node infra/render/validate-blueprint.mjs",
    "dev:web": "npm --prefix apps/web-react run dev",
    "dev:backend": "npm --prefix apps/backend run dev",
    "test:browser:audit": "node e2e/test-integration-audit.cjs",
    "test:browser:live": "node e2e/test-dual-terminals.js",
    "docs:language": "node scripts/docs/check-language.mjs",
    "docs:links": "node scripts/docs/check-links.mjs",
    "docs:markdown": "markdownlint-cli2",
    "docs:mermaid": "node scripts/docs/check-mermaid.mjs",
    "docs:check": "npm run docs:language && npm run docs:links && npm run docs:markdown && npm run docs:mermaid",
    "test:charts": "node --test packages/openfund-charts/test/pine.test.mjs",
    "test:browser:charts": "node e2e/test-chart-indicators.mjs",
    "test:browser:unified": "node e2e/test-unified-trading.cjs",
    "test:browser:layout": "node e2e/test-terminal-layout.cjs",
    "test:browser:completion": "node e2e/test-terminal-completion.cjs",
    "release:build": "node scripts/release/build.mjs",
    "release:local": "node scripts/release/local.mjs",
    "release:version": "node scripts/release/version.mjs",
    "test:release": "node --test scripts/release/test/*.test.mjs",
    "test:browser:release": "node e2e/test-release.cjs",
    "test:browser:purchase": "node e2e/test-purchase-flow.cjs",
    "test:browser:challenge": "node e2e/test-challenge-lifecycle.cjs",
    "test:browser:auto-dark": "node e2e/test-auto-dark.cjs",
    "test:browser:routes": "node scripts/release/public-routes.mjs",
    "test:browser:routing": "node e2e/test-clean-routing.cjs",
    "test:browser:polish": "node e2e/test-ui-polish.cjs",
    "test:browser:website": "node e2e/test-website-refresh.cjs",
    "test:browser:wallet": "node e2e/test-wallet-connect.cjs",
    "test:browser:locale": "node e2e/test-locale-matrix.cjs"
  },
  "devDependencies": {
    "js-yaml": "^4.1.0",
    "jsdom": "27.0.1",
    "markdownlint-cli2": "0.24.0",
    "mermaid": "12.2.0",
    "playwright": "^1.64.1"
  },
  "overrides": {
    "markdownlint": {
      "re2js": "2.8.7"
    },
    "micromark-extension-math": {
      "katex": "0.18.11"
    }
  }
}
