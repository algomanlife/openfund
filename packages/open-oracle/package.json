{
  "name": "@openfund/open-oracle",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "description": "Isolated read-only GAACP v1 reference-price research protocol",
  "exports": {
    ".": "./src/index.mjs",
    "./pricing": "./src/pricing.ts"
  },
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "node scripts/lint.mjs",
    "validate:live": "node scripts/live.mjs",
    "validate:service": "node scripts/service-live.mjs",
    "benchmark": "node --expose-gc scripts/benchmark.mjs",
    "calibrate": "node scripts/calibrate.mjs",
    "start": "node scripts/serve.mjs",
    "test:socket": "node --test tests/socket.mjs"
  },
  "devDependencies": {
    "typescript": "6.0.3"
  }
}
