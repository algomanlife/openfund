{
  "name": "openfund-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Openfund backend \u2014 SIWE wallet authentication, sessions, users & challenges (PostgreSQL). Directus remains the admin data interface, never the auth boundary.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "migrate": "node migrate.js",
    "seed-plans": "node seed-plans.js",
    "test": "node test/siwe.test.mjs",
    "test:products": "node test/products.test.mjs",
    "test:static": "node --test test/static-cache.test.mjs test/seo.test.mjs",
    "test:gains": "node --test test/gains-portfolio.test.mjs",
    "test:all": "node --test test/static-cache.test.mjs test/seo.test.mjs && node test/siwe.test.mjs && node test/trading.test.mjs && node test/portfolio.test.mjs && node test/products.test.mjs && node --test test/gains-portfolio.test.mjs && npm run test:audit && npm run test:unified && npm run test:referral && npm run test:evaluation && npm run test:engine && npm run test:admin && npm run test:purchases && npm run test:economy && npm run test:governance && npm run test:payments && npm run test:commerce && npm run test:chart-workspaces && npm run test:footprint",
    "test:evaluation": "node test/evaluation.test.mjs",
    "test:admin": "node test/admin.test.mjs",
    "test:purchases": "node test/purchases.test.mjs",
    "test:audit": "node --test test/audit.test.mjs",
    "test:unified": "node --test test/unified.test.mjs test/instruments.test.mjs test/unified-api.test.mjs",
    "test:referral": "node test/referral.test.mjs",
    "test:engine": "node --test test/engine-rules.test.mjs test/engine-audit.test.mjs",
    "test:governance": "node --test --test-concurrency=1 test/governance-rules.test.mjs test/governance.test.mjs test/governance-http.test.mjs",
    "test:economy": "node --test test/economy-math.test.mjs test/treasury.test.mjs test/live-funding.test.mjs test/partners.test.mjs",
    "test:payments": "node --test test/payment-verification.test.mjs && node test/payments-admin.test.mjs",
    "test:commerce": "node --test --test-concurrency=1 test/commerce.test.mjs",
    "test:chart-workspaces": "node --test test/chart-workspaces.test.mjs",
    "test:footprint": "node --test --test-concurrency=1 test/footprint.test.mjs test/footprint-archive.test.mjs"
  },
  "dependencies": {
    "decimal.js": "^10.6.0",
    "esbuild": "^0.28.2",
    "express": "^4.21.2",
    "pg": "^8.13.1",
    "viem": "^2.57.19",
    "ws": "^8.22.2"
  }
}
