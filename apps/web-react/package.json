{
  "name": "openfund-web-react",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5173",
    "test:information": "node --test test/information.test.mjs",
    "test:markets": "node --test test/markets.test.mjs",
    "test:plans": "node --test test/challenge-plans.test.mjs",
    "build": "vite build",
    "build:check": "tsc --noEmit",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "build:charts": "node ../../scripts/build-charts.mjs",
    "prebuild": "npm run build:charts",
    "predev": "npm run build:charts",
    "test:depth": "node --test test/market-depth.test.mjs",
    "test:website": "node --test test/website-expansion.test.mjs",
    "test:whitepaper": "node --test test/whitepaper.test.mjs",
    "test:terminal": "node --test test/terminal-completion.test.mjs",
    "test:i18n": "node scripts/i18n-sources.mjs --check",
    "test:governance": "node --test test/governance.test.mjs",
    "test:chart": "node --test test/chart-quick-trade.test.mjs",
    "test:content": "node --test test/public-content.test.mjs test/community.test.mjs",
    "check:product-rules": "node --test test/product-rules.test.mjs"
  },
  "dependencies": {
    "@luxalgo/vela": "0.9.3",
    "@luxalgo/vela-pinets": "0.3.2",
    "@rainbow-me/rainbowkit": "^2.2.11",
    "@tanstack/react-query": "^5.107.1",
    "pinets": "0.13.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.1.0",
    "viem": "^2.57.16",
    "wagmi": "^2.19.5"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "0.28.2",
    "typescript": "~5.9.3",
    "vite": "^6.0.5"
  }
}
