# Openfund Directus environment (dockerized deployment)
# cp .env.example .env  — fill real values; NEVER commit the filled .env

# generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
DIRECTUS_KEY=
DIRECTUS_SECRET=

# initial admin (used on first start only)
DIRECTUS_ADMIN_EMAIL=admin@openfund.dev
DIRECTUS_ADMIN_PASSWORD=change-me-immediately

# PostgreSQL
POSTGRES_DB=openfund_cms
POSTGRES_USER=openfund_cms
POSTGRES_PASSWORD=change-me-too

# ---- React app side (apps/web-react/.env) ----
# VITE_DIRECTUS_URL=https://your-directus-host.example
