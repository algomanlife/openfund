.qa/
node_modules/
publish-openfund/

# Directus backstage (local secrets + runtime + data volumes)
infrastructure/directus/.env
infrastructure/directus/runtime/
infrastructure/directus/data/
apps/web-react/.env

# Local environment files and key material anywhere in the tree. Committed
# templates stay tracked through the negation below.
.env
.env.*
!.env.example
!**/.env.example
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*

# Local verification artifacts (may contain private test-session exports)
/output/
/.playwright-cli/
/.playwright/
__pycache__/

# Generated frontend build output (Vite -> repo-root react/). Never tracked: every
# build rewrites content-hashed files, which made every frontend pull request
# conflict. Render, the release gates and CI all build it (npm run build:web).
/react/
# Generated identity is packaged by the release pipeline.
/release-manifest.json

# Ignore future Finder metadata in the preserved investor package.
/docs/business/Openfund-Prop-Investor-Pack/**/.DS_Store

# Build/test scratch
*.log
.DS_Store
**/.DS_Store
coverage/
*.tsbuildinfo
