{
  "$comment": "Single source of truth for Openfund's Liara infrastructure and the GitHub environments that deploy to it (ADR 0042). No secrets: `secrets` lists NAMES that must exist in the app's Liara environment. Identifiers are the LIVE ones: production predates this convention (web app `openfund-iran`, private network `staging`) and is not renamed, because renaming recreates the resource. `provisioned: false` = declared but not created yet (live checks skip it, deploy guards refuse it). `plan: null` = owner must choose a Liara plan before --apply. Applied by scripts/liara/provision.mjs (plan by default, create-only, never deletes); drift is checked by scripts/liara/check-infra.mjs.",
  "version": 1,
  "global": {
    "$comment": "GLOBAL production on Render: never a target of any Liara workflow; its database must never be an Iran DATABASE_URL.",
    "provider": "render",
    "services": [
      "openfund",
      "openfund-backstage",
      "openfund-cms"
    ],
    "database": "openfund-db",
    "githubEnvironments": [
      "production",
      "main - openfund",
      "main - openfund-backstage",
      "main - openfund-db"
    ],
    "forbiddenDatabaseHostPatterns": [
      "render.com",
      "onrender.com",
      "dpg-"
    ]
  },
  "environments": {
    "staging": {
      "provisioned": false,
      "github": {
        "environment": "liara-iran-runtime-staging",
        "requiredReviewers": true,
        "publicUrlHost": "openfund-iran-staging.liara.run"
      },
      "network": "openfund-iran-staging-net",
      "database": {
        "name": "openfund-iran-staging-db",
        "type": "postgres",
        "version": "17.10",
        "plan": null,
        "publicNetwork": false
      },
      "apps": [
        {
          "id": "openfund-iran-staging",
          "role": "web",
          "platform": "docker",
          "plan": null,
          "config": "infra/liara-iran-runtime/liara.web.json",
          "env": {
            "OPENFUND_REGION": "IRAN",
            "OPENFUND_ROLES": "http,market-data",
            "MIGRATE_ON_START": "1",
            "FOOTPRINT_ENABLED": "0",
            "GEO_FALLBACK_LOCALE": "fa",
            "PUBLIC_ORIGIN": "https://openfund-iran-staging.liara.run"
          },
          "secrets": [
            "DATABASE_URL",
            "ADMIN_API_TOKEN",
            "ALLOWED_DOMAINS",
            "CORS_ORIGINS",
            "CMS_PUBLIC_URL",
            "REGION_SYNC_KEYS",
            "REGION_SYNC_ACTIVE_KID",
            "REGION_SYNC_PEER_URL"
          ],
          "public": true,
          "$comment": "Served on its default subdomain openfund-iran-staging.liara.run (no custom domain)."
        },
        {
          "id": "openfund-iran-staging-worker",
          "role": "worker",
          "platform": "docker",
          "plan": null,
          "config": "infra/liara-iran-runtime/liara.worker.json",
          "env": {
            "OPENFUND_REGION": "IRAN",
            "OPENFUND_ROLES": "engine,market-data,sync",
            "FOOTPRINT_ENABLED": "0"
          },
          "secrets": [
            "DATABASE_URL",
            "CMS_PUBLIC_URL",
            "REGION_SYNC_KEYS",
            "REGION_SYNC_ACTIVE_KID",
            "REGION_SYNC_PEER_URL"
          ],
          "public": false
        },
        {
          "id": "openfund-iran-staging-cms",
          "role": "cms",
          "platform": "docker",
          "plan": null,
          "config": "infra/liara-iran-runtime/liara.cms.json",
          "disks": [
            {
              "name": "directus-uploads",
              "sizeGB": 5
            }
          ],
          "env": {
            "DB_CLIENT": "pg",
            "WEBSOCKETS_ENABLED": "false",
            "CORS_ENABLED": "true",
            "CORS_ORIGIN": "true",
            "CORS_METHODS": "GET,HEAD,OPTIONS",
            "IP_TRUST_PROXY": "true",
            "PORT": "8055"
          },
          "secrets": [
            "DB_CONNECTION_STRING",
            "KEY",
            "SECRET",
            "ADMIN_EMAIL",
            "ADMIN_PASSWORD",
            "PUBLIC_URL"
          ],
          "public": true
        }
      ]
    },
    "production": {
      "provisioned": true,
      "github": {
        "environment": "liara-iran-runtime",
        "requiredReviewers": true,
        "publicUrlHost": "openfi.live"
      },
      "network": "staging",
      "database": {
        "name": "openfund-iran-db",
        "type": "postgres",
        "version": "17.10",
        "plan": null,
        "publicNetwork": false
      },
      "apps": [
        {
          "id": "openfund-iran",
          "role": "web",
          "platform": "docker",
          "plan": null,
          "config": "infra/liara-iran-runtime/liara.web.json",
          "env": {
            "OPENFUND_REGION": "IRAN",
            "OPENFUND_ROLES": "http,market-data",
            "MIGRATE_ON_START": "1",
            "FOOTPRINT_ENABLED": "0",
            "GEO_FALLBACK_LOCALE": "fa",
            "PUBLIC_ORIGIN": "https://openfi.live",
            "CANONICAL_ALIAS_HOSTS": "www.openfi.live,iran.openfund.cloud,iran.openfi.cloud"
          },
          "secrets": [
            "DATABASE_URL",
            "ADMIN_API_TOKEN",
            "ALLOWED_DOMAINS",
            "CORS_ORIGINS",
            "CMS_PUBLIC_URL",
            "REGION_SYNC_KEYS",
            "REGION_SYNC_ACTIVE_KID",
            "REGION_SYNC_PEER_URL"
          ],
          "domains": [
            "openfi.live",
            "www.openfi.live",
            "iran.openfund.cloud",
            "iran.openfi.cloud"
          ],
          "public": true,
          "$comment": "Canonical https://openfi.live (ADR 0043); the other domains 301 to it. market-data runs here too: this process executes orders and needs fresh marks; the worker's engine loop runs SL/TP and liquidation (row locks serialize them, test/split-process-engine.test.mjs)."
        },
        {
          "id": "openfund-iran-worker",
          "role": "worker",
          "platform": "docker",
          "plan": null,
          "config": "infra/liara-iran-runtime/liara.worker.json",
          "env": {
            "OPENFUND_REGION": "IRAN",
            "OPENFUND_ROLES": "engine,market-data,sync",
            "FOOTPRINT_ENABLED": "0"
          },
          "secrets": [
            "DATABASE_URL",
            "CMS_PUBLIC_URL",
            "REGION_SYNC_KEYS",
            "REGION_SYNC_ACTIVE_KID",
            "REGION_SYNC_PEER_URL"
          ],
          "public": false
        },
        {
          "id": "openfund-iran-cms",
          "role": "cms",
          "platform": "docker",
          "plan": null,
          "config": "infra/liara-iran-runtime/liara.cms.json",
          "disks": [
            {
              "name": "directus-uploads",
              "sizeGB": 5
            }
          ],
          "env": {
            "DB_CLIENT": "pg",
            "WEBSOCKETS_ENABLED": "false",
            "CORS_ENABLED": "true",
            "CORS_ORIGIN": "true",
            "CORS_METHODS": "GET,HEAD,OPTIONS",
            "IP_TRUST_PROXY": "true",
            "PORT": "8055"
          },
          "secrets": [
            "DB_CONNECTION_STRING",
            "KEY",
            "SECRET",
            "ADMIN_EMAIL",
            "ADMIN_PASSWORD",
            "PUBLIC_URL"
          ],
          "public": true,
          "provisioned": false
        }
      ]
    }
  },
  "legacyEdge": {
    "$comment": "ADR 0031 reverse proxy (infra/liara-iran, deploy-liara-iran.yml). Dormant: never deployed; ADR 0033's runtime serves the Iran domains. Its apps must never be a runtime app.",
    "status": "dormant",
    "workflow": ".github/workflows/deploy-liara-iran.yml",
    "environments": {
      "staging": {
        "github": "liara-iran-staging",
        "app": "openfund-iran-edge-staging"
      },
      "production": {
        "github": "liara-iran",
        "app": "openfund-iran-edge"
      }
    }
  }
}
