# Liara app environment for the Iran edge (docs/deployment/LIARA_IRAN.md).
# Names and safe placeholders only. None of these values is secret; the edge
# holds no secrets at all. Enter them in the Liara console:
# app > Settings > Variables.

# Render origin host for the openfund service (bare host, no scheme or path).
# Use the onrender.com host, not openfund.cloud (that goes back through Cloudflare).
OPENFUND_UPSTREAM_HOST=your-render-service.onrender.com

# Listening port; must equal the Liara app port (liara.json "port").
EDGE_PORT=8080
