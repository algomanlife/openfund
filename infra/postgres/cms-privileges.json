 "$comment": "OF-2026-11-12: table-by-table PostgreSQL privileges of the Directus CMS role on backend-owned tables. Applied by scripts/ops/db-roles.mjs. Every table created by apps/backend/schema.sql or apps/backend/footprint/schema.sql must appear here; anything absent is refused by the check. Protected tables may be at most readable.",
 "roles": {
  "owner": {
   "default": "openfund_app",
   "purpose": "Database owner and migration role: runs migrate.js, owns every backend table, function and sequence. Never given to Directus."
  },
  "runtime": {
   "default": "openfund_runtime",
   "purpose": "Backend API runtime: DML on backend tables, no DDL, no ownership. Optional until DATABASE_URL is switched (see docs/security/DATABASE_ROLES.md)."
  },
  "cms": {
   "default": "openfund_directus",
   "purpose": "Directus: owns directus_* and the editorial collections it creates; on backend tables only the grants below."
  },
  "readonly": {
   "default": "openfund_readonly",
   "purpose": "Operations and reporting: SELECT only, NOLOGIN group role."
  }
 },
